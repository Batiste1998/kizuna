# ─── PostgreSQL (Docker Compose) ───────────────────────────────
POSTGRES_USER=kizuna
POSTGRES_PASSWORD=kizuna
POSTGRES_DB=kizuna
POSTGRES_PORT=5432
ADMINER_PORT=8081

# Connection string used by Drizzle + the API
DATABASE_URL=postgresql://kizuna:kizuna@localhost:5432/kizuna

# ─── API (NestJS) ──────────────────────────────────────────────
API_PORT=3001
API_URL=http://localhost:3001
# Comma-separated list of allowed origins (the web app)
CORS_ORIGINS=http://localhost:3000

# ─── Better Auth ───────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-in-production
BETTER_AUTH_URL=http://localhost:3001

# ─── Uploads (documents) ───────────────────────────────────────
UPLOAD_DIR=var/uploads
MAX_UPLOAD_MB=10

# ─── Email (transactionnel) ────────────────────────────────────
# Public URL of the web app — used to build links in emails
WEB_PUBLIC_URL=http://localhost:3000
MAIL_FROM=Kizuna <no-reply@kizuna.dev>
# Leave SMTP_HOST empty in dev: emails are logged to the API console instead.
# For a local inbox, run MailHog and set SMTP_HOST=localhost SMTP_PORT=1025
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# ─── IA (OpenAI, optionnel) ────────────────────────────────────
# Sans clé, les fonctions IA (import de référentiel, assistant, synthèses)
# sont simplement masquées dans l'interface.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# ─── Web (TanStack Start) ──────────────────────────────────────
WEB_PORT=3000
VITE_API_URL=http://localhost:3001
